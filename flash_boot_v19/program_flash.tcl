# Run through bw_commands_prompt.exe. This writes the configuration Flash.
# V19 BIT and BIN were generated by TD and must remain paired.
set root [file dirname [file normalize [info script]]]
set bit [file join $root competition_recovery_v19.bit]
set bin [file join $root competition_recovery_v19.bin]
set svf [file join $root competition_recovery_v19_flash.svf]
set before [file join $root backup flash_before_v19.bin]
if {![file exists $bit] || [file size $bit] != 629632} {error "Missing or wrong-size V19 BIT"}
if {![file exists $bin] || [file size $bin] != 626777} {error "Missing or wrong-size V19 BIN"}
if {![file exists $before] || [file size $before] != 2097152} {error "Original 2 MiB Flash backup is required"}
set device [read_device_id -cable 0 -level 1 -total 1]
if {[string trim $device] ne "EG4S20BG256"} {error "Unexpected FPGA: $device"}
puts "Programming V19 into the configuration Flash at address 0. Keep power connected."
if {![file exists $svf] || [file size $svf] != 5335434} {error "Missing or wrong-size V19 Flash SVF"}
program_svf -svf $svf -spd 4 -cable 0
set readback [file join $root flash_after_v19_[clock seconds].bin]
download -mode rdbk_spi -cable 0 -spd 7 -start_addr 0x000000 -data_length 626777 -rdbk $readback
set fh [open $bin rb]
set expected [read $fh]
close $fh
set fh [open $readback rb]
set actual [read $fh]
close $fh
if {$actual ne $expected} {error "FLASH READBACK MISMATCH; do not mark the board completed"}
puts "FLASH_V19_BYTE_COMPARE_OK: [string length $actual] bytes match the TD-generated BIN."
puts "Power-off/power-on confirmation is still required."
exit
